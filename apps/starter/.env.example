# Copy to .env.local. Leave the project ID empty to run on demo content.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# The Sanity CLI (sanity deploy / dataset import) reads these instead
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# --- Preview site only -------------------------------------------------------
# Turns on drafts, stega overlays, live updates and drag-and-drop.
# Never set this to true on the production site: the read token reaches the browser.
NEXT_PUBLIC_SANITY_VISUAL_EDITING=false
# Viewer token from sanity.io/manage > API > Tokens
SANITY_API_READ_TOKEN=

# --- Both sites --------------------------------------------------------------
# Where the Presentation tool opens pages. Set it to the preview site's URL so
# editors always land on the draft-capable site, wherever the Studio is opened.
NEXT_PUBLIC_SANITY_PREVIEW_URL=
