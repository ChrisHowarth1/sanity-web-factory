{
  "name": "web-factory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @factory/starter dev",
    "build": "pnpm --filter @factory/starter build",
    "typecheck": "pnpm -r typecheck",
    "factory:new": "node scripts/factory/new.mjs",
    "seed": "pnpm --filter @factory/starter seed",
    "ui:add": "node scripts/ui-add.mjs"
  },
  "dependencies": {
    "@sanity/icons": "^5.3.0",
    "@sanity/ui": "^4.4.10",
    "sanity": "^6.22.0",
    "styled-components": "^6.6.0"
  }
}
